---
import { getTranslations, DEFAULT_LOCALE, type Locale } from "../../src/i18n";
import { t } from "../../src/i18n";

const { siteUrl, lastUpdated } = Astro.props;
const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const dict = getTranslations(locale);
---
<footer class="site-footer">
  <div class="container">
    <p class="disclaimer">
      {t(dict, "footer.disclaimer")}
    </p>
    {lastUpdated && <p class="meta">{t(dict, "footer.lastUpdated", { date: lastUpdated })}</p>}
  </div>
</footer>
<style>
  .site-footer { background: var(--color-bg-alt); border-top: 1px solid var(--color-border); margin-top: var(--space-7); padding: var(--space-5) 0; font-size: 13px; color: var(--color-text-soft); }
</style>
