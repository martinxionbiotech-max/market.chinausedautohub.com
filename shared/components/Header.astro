---
import { MAIN_SITE_URL, DATA_SITE_URL, COMPANIES_SITE_URL, TOOLS_SITE_URL, MARKET_SITE_URL } from "../config/config";
import { getTranslations, DEFAULT_LOCALE, LOCALES, type Locale } from "../../src/i18n";
import { localizedPath } from "../../src/lib/i18n";

const { siteTitle, currentSection, showLangSwitcher = false } = Astro.props;
const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = getTranslations(locale);
const path = Astro.url.pathname;

const links = [
  { label: t.nav.vehicles, url: MAIN_SITE_URL + "/", key: "vehicles" },
  { label: t.nav.vehicleData, url: DATA_SITE_URL + "/", key: "data" },
  { label: t.nav.companies, url: COMPANIES_SITE_URL + "/", key: "companies" },
  { label: t.nav.tools, url: TOOLS_SITE_URL + "/", key: "tools" },
  { label: t.nav.markets, url: MARKET_SITE_URL + "/", key: "market" },
];
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="site-brand">{siteTitle}</a>
    <nav class="eco-nav" aria-label="Ecosystem">
      {links.map((l) => (
        <a href={l.url} class={l.key === currentSection ? "current" : ""}>{l.label}</a>
      ))}
    </nav>
    {showLangSwitcher && (
      <nav class="lang-nav" aria-label={t.nav.language}>
        {LOCALES.map((l) => (
          <a
            href={localizedPath(path, l.code)}
            class={l.code === locale ? "lang current" : "lang"}
            hreflang={l.code}
            lang={l.code}
          >{l.code.toUpperCase()}</a>
        ))}
      </nav>
    )}
  </div>
</header>
<style>
  .site-header { background: var(--color-primary); color: #fff; }
  .header-inner { display: flex; align-items: center; gap: var(--space-5); padding: 12px 16px; flex-wrap: wrap; }
  .site-brand { font-weight: 700; font-size: 18px; color: #fff; }
  .eco-nav { display: flex; gap: var(--space-4); flex-wrap: wrap; }
  .eco-nav a { color: #cfe0f2; font-size: 14px; }
  .eco-nav a:hover { color: #fff; }
  .eco-nav a.current { color: #fff; font-weight: 700; }
  .lang-nav { display: flex; gap: var(--space-2); margin-inline-start: auto; align-items: center; }
  .lang-nav .lang { color: #cfe0f2; font-size: 12px; font-weight: 600; padding: 2px 6px; border-radius: var(--radius-sm); }
  .lang-nav .lang:hover { color: #fff; text-decoration: none; }
  .lang-nav .lang.current { background: rgba(255,255,255,0.18); color: #fff; }
</style>
