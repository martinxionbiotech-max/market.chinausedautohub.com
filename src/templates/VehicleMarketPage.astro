---
import BaseLayout from "../../shared/components/BaseLayout.astro";
import SourceNote from "../../shared/components/SourceNote.astro";
import {
  MARKET_SITE_URL,
  DATA_SITE_URL,
  TOOLS_SITE_URL,
  MAIN_SITE_URL,
} from "../../shared/config/config";
import {
  getCountry,
  getModel,
  getBrand,
  rulesByCategory,
  portName,
  getRoutesForCountry,
  rateLabel,
} from "../lib/market";
import {
  relations,
  getRelation,
  getRelationsForCountry,
  getRelationsForVehicle,
  incrementTypes,
  passesGate,
  dutyAnchorsFor,
  relConfidenceLabel,
  relConfidenceClass,
  decisionPoints,
  keyRisks,
  checklist,
} from "../lib/vehicle-market";
import { getTranslations, DEFAULT_LOCALE, t, type Locale } from "../i18n";
import { localizedUrl } from "../lib/i18n";

interface Props {
  countryId: string;
  vehicleId: string;
}

const { countryId, vehicleId } = Astro.props;
const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const dict = getTranslations(locale);

const country = getCountry(countryId);
const model = getModel(vehicleId);
const brand = model ? getBrand(model.brand_id) : undefined;
const rel = getRelation(vehicleId, countryId);

const increments = rel ? incrementTypes(rel) : [];
const duty = rel ? dutyAnchorsFor(rel) : null;

const driveRules = rulesByCategory(countryId, "drive_side");
const ageRules = rulesByCategory(countryId, "vehicle_age");
const evRules = rulesByCategory(countryId, "ev_policy");

const powertrains = model
  ? [...new Set(model.generations.flatMap((g) => g.trims.map((x) => x.powertrain)))]
  : [];
const powertrainLabel = (p: string) => t(dict, `vehicle.powertrain.${p}`) !== `vehicle.powertrain.${p}`
  ? t(dict, `vehicle.powertrain.${p}`)
  : p;

const brandName = brand?.name ?? t(dict, "common.notAvailable");
const modelName = model?.name ?? vehicleId;
const countryName = country?.name ?? countryId;

// Localized helpers.
const sect = (k: string, v?: Record<string, string | number>) => t(dict, `vehicle.sections.${k}`, v);
const misc = (k: string, v?: Record<string, string | number>) => t(dict, `vehicle.misc.${k}`, v);
const qf = (k: string) => t(dict, `vehicle.quickFacts.${k}`);
const cl = (field: any) => t(dict, `confidence.labels.${relConfidenceLabel(field)}`);
const na = t(dict, "common.notAvailable");
const verifyCaveat = t(dict, "vehicle.misc.verifyCaveat");
const chargingCaveat = t(dict, "vehicle.misc.chargingCaveat");
const dealerCaveat = t(dict, "vehicle.misc.dealerCaveat");
const dutyCaveat = t(dict, "vehicle.misc.dutyCaveat");
const transitCaveat = t(dict, "vehicle.misc.transitCaveat");

const pageUrl = MARKET_SITE_URL + localizedUrl(`/countries/${countryId}/${vehicleId}/`, locale);
const title = t(dict, "vehicle.title", { model: modelName, country: countryName });
const description = t(dict, "vehicle.description", { model: modelName, zh: model?.name_zh ?? "", country: countryName });

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  url: pageUrl,
  dateModified: rel?.checked_date ?? "2026-10-06",
  inLanguage: locale,
  about: [
    { "@type": "Vehicle", name: modelName, brand: { "@type": "Brand", name: brandName } },
    { "@type": "Country", name: countryName },
  ],
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t(dict, "breadcrumb.markets"), item: MARKET_SITE_URL + "/" },
    { "@type": "ListItem", position: 2, name: countryName, item: MARKET_SITE_URL + localizedUrl(`/countries/${countryId}/`, locale) },
    { "@type": "ListItem", position: 3, name: modelName, item: pageUrl },
  ],
};

const verdictRaw =
  rel?.drive_side_fit?.status === "mismatch"
    ? "notEligibleAsIs"
    : rel?.age_rule_fit?.status === "ineligible"
      ? "notEligible"
      : rel?.needs_review || rel?.confidence === "low"
        ? "needsReview"
        : "eligibleNeedsReview";
const verdict = t(dict, `vehicle.verdict.${verdictRaw}`);
const verdictClass =
  verdictRaw === "notEligibleAsIs" || verdictRaw === "notEligible"
    ? "bad"
    : verdictRaw === "needsReview"
      ? "warn"
      : "ok";

const driveSideLabel = country?.drive_side === "lhd" ? t(dict, "common.lhd") : t(dict, "common.rhd");
const driveFitLabel =
  rel?.drive_side_fit?.status === "match"
    ? t(dict, "vehicle.driveFit.match")
    : rel?.drive_side_fit?.status === "mismatch"
      ? t(dict, "vehicle.driveFit.mismatch")
      : na;
const ageFitLabel =
  rel?.age_rule_fit?.status === "eligible"
    ? t(dict, "vehicle.ageFit.eligible")
    : rel?.age_rule_fit?.status === "borderline"
      ? t(dict, "vehicle.ageFit.borderline")
      : rel?.age_rule_fit?.status === "ineligible"
        ? t(dict, "vehicle.ageFit.ineligible")
        : na;
const methodLabel = (m: string) => (m === "roro" ? t(dict, "common.roro") : t(dict, "common.container"));
const shippingRoutes = getRoutesForCountry(countryId);

const siblingPairs = getRelationsForCountry(countryId).filter((r) => r.vehicle_id !== vehicleId);
const decision = rel ? decisionPoints(rel, locale) : null;
const risks = rel ? keyRisks(rel, locale) : [];
const checklistItems = rel ? checklist(rel, locale) : [];
const sameVehicleOtherCountries = rel
  ? getRelationsForVehicle(vehicleId).filter((r) => r.country_id !== countryId)
  : [];

const hasLimitations =
  rel?.drive_side_fit?.status === "mismatch" ||
  rel?.age_rule_fit?.status === "borderline" ||
  rel?.age_rule_fit?.status === "ineligible" ||
  !!rel?.ev_charging_compat?.needs_adapter;

const incLabel = (i: string) => t(dict, `vehicle.increments.${i}`);
const incrementsText = increments.map(incLabel).join(" · ");
---

<BaseLayout
  siteTitle={t(dict, "site.name")}
  siteUrl={MARKET_SITE_URL}
  currentSection="market"
  title={title}
  description={description}
  canonical={`/countries/${countryId}/${vehicleId}/`}
  jsonLd={[articleLd, breadcrumbLd]}
  localized
  breadcrumbs={[
    { name: t(dict, "breadcrumb.markets"), url: localizedUrl("/", locale) },
    { name: countryName, url: localizedUrl(`/countries/${countryId}/`, locale) },
    { name: modelName, url: localizedUrl(`/countries/${countryId}/${vehicleId}/`, locale) },
  ]}
>
  <h1>{modelName} <span class="zh">{model?.name_zh}</span> → {countryName}</h1>
  <p class="meta-line">{t(dict, "vehicle.metaLine", { date: rel?.checked_date ?? na })}</p>

  <p class="disclaimer">{t(dict, "vehicle.disclaimer")}</p>

  <!-- ============ Quick Facts (AIO structured block) ============ -->
  <section class="quick-facts" aria-label={qf("title")}>
    <h2>{qf("title")}</h2>
    <div class="qf-grid">
      <div class="qf"><span class="qf-k">{qf("vehicle")}</span><span class="qf-v">{modelName}</span></div>
      <div class="qf"><span class="qf-k">{qf("brand")}</span><span class="qf-v">{brandName}</span></div>
      <div class="qf"><span class="qf-k">{qf("country")}</span><span class="qf-v">{countryName}</span></div>
      <div class="qf"><span class="qf-k">{qf("powertrain")}</span><span class="qf-v">{powertrains.length ? powertrains.map(powertrainLabel).join(", ") : na}</span></div>
      <div class="qf"><span class="qf-k">{qf("driveSideFit")}</span><span class="qf-v">{driveFitLabel}</span></div>
      <div class="qf"><span class="qf-k">{qf("ageRuleFit")}</span><span class="qf-v">{ageFitLabel}</span></div>
      <div class="qf"><span class="qf-k">{qf("importDutyRange")}</span><span class="qf-v">{duty ? duty.rangeLabel : na}</span></div>
      <div class="qf"><span class="qf-k">{qf("confidence")}</span><span class="qf-v"><span class={"badge " + relConfidenceClass(rel)}>{cl(rel)}</span></span></div>
    </div>
  </section>

  <!-- At-a-glance verdict -->
  <section>
    <h2>{t(dict, "vehicle.verdict.title")}</h2>
    <p class={`verdict verdict-${verdictClass}`}>{verdict}</p>
    {increments.length > 0 ? (
      <p>
        {misc("incrementsIntro", { model: modelName, country: countryName, increments: incrementsText })}
      </p>
    ) : (
      <p>{misc("noIndependent")}</p>
    )}
  </section>

  <!-- Buyer decision points -->
  <section>
    <h2>{sect("buyerDecisionPoints")}</h2>
    {decision && (decision.suitable.length > 0 || decision.notSuitable.length > 0) ? (
      <>
        {decision.suitable.length > 0 && (
          <>
            <h3 class="dp-head dp-head-yes">{sect("suitableWhen")}</h3>
            <ul class="dp-list">
              {decision.suitable.map((d) => (
                <li class="dp dp-yes">
                  <span class="dp-text">{d.text}</span>
                  <SourceNote source={d.source} sourceUrl={d.source_url} sourceDate={d.checked_date} confidenceLabel={relConfidenceLabel(d)} caveat={d.needs_review ? verifyCaveat : undefined} />
                </li>
              ))}
            </ul>
          </>
        )}
        {decision.notSuitable.length > 0 && (
          <>
            <h3 class="dp-head dp-head-no">{sect("notSuitableWhen")}</h3>
            <ul class="dp-list">
              {decision.notSuitable.map((d) => (
                <li class="dp dp-no">
                  <span class="dp-text">{d.text}</span>
                  <SourceNote source={d.source} sourceUrl={d.source_url} sourceDate={d.checked_date} confidenceLabel={relConfidenceLabel(d)} caveat={d.needs_review ? verifyCaveat : undefined} />
                </li>
              ))}
            </ul>
          </>
        )}
      </>
    ) : (
      <p>{misc("noDecision")}</p>
    )}
  </section>

  <!-- 1. Why this vehicle may fit -->
  <section>
    <h2>{sect("whyFit")}</h2>
    {rel?.powertrain_fit ? (
      <>
        <p>{rel.powertrain_fit.summary}</p>
        <SourceNote source={rel.powertrain_fit.source} sourceUrl={rel.powertrain_fit.source_url} sourceDate={rel.powertrain_fit.checked_date} confidenceLabel={relConfidenceLabel(rel.powertrain_fit)} caveat={rel.powertrain_fit.needs_review ? verifyCaveat : undefined} />
      </>
    ) : (
      <p>{misc("noFit")}</p>
    )}
  </section>

  <!-- 2. Powertrain -->
  <section>
    <h2>{sect("powertrain")}</h2>
    {powertrains.length ? (
      <ul>{powertrains.map((p) => <li>{powertrainLabel(p)}</li>)}</ul>
    ) : (
      <p>{misc("powertrainNone")}</p>
    )}
    <p class="review-hint" set:html={misc("powertrainRef", { link: `<a href="${DATA_SITE_URL}/models/${vehicleId}/">${misc("dataModelPage")}</a>` })} />
  </section>

  <!-- 3. Drive side -->
  <section>
    <h2>{sect("driveSide")}</h2>
    <p class="drive-callout">{driveSideLabel}</p>
    {rel?.drive_side_fit ? (
      <>
        <p>{rel.drive_side_fit.summary}</p>
        <SourceNote source={rel.drive_side_fit.source} sourceUrl={rel.drive_side_fit.source_url} sourceDate={rel.drive_side_fit.checked_date} confidenceLabel={relConfidenceLabel(rel.drive_side_fit)} caveat={rel.drive_side_fit.needs_review ? verifyCaveat : undefined} />
      </>
    ) : (
      <p>{misc("noDriveFit")}</p>
    )}
    {driveRules.map((r) => (
      <div class="rule">
        <div class="rule-head">
          <h3>{r.title}</h3>
          {r.needs_review && <span class="badge-review">{t(dict, "common.needsReview")}</span>}
        </div>
        <p>{r.rule_text}</p>
        <SourceNote source={r.source} sourceUrl={r.source_url} sourceDate={r.last_checked} confidenceLabel={r.source_url && !r.needs_review ? "Source-backed" : "Needs verification"} />
      </div>
    ))}
  </section>

  <!-- 4. Vehicle age -->
  <section>
    <h2>{sect("vehicleAge")}</h2>
    {rel?.age_rule_fit ? (
      <>
        <p>{rel.age_rule_fit.summary}</p>
        <SourceNote source={rel.age_rule_fit.source} sourceUrl={rel.age_rule_fit.source_url} sourceDate={rel.age_rule_fit.checked_date} confidenceLabel={relConfidenceLabel(rel.age_rule_fit)} caveat={rel.age_rule_fit.needs_review ? verifyCaveat : undefined} />
      </>
    ) : (
      <p>{misc("noAgeComputation")}</p>
    )}
    {ageRules.map((r) => (
      <div class="rule">
        <div class="rule-head">
          <h3>{r.title}</h3>
          {r.needs_review && <span class="badge-review">{t(dict, "common.needsReview")}</span>}
        </div>
        <p>{r.rule_text}</p>
        <SourceNote source={r.source} sourceUrl={r.source_url} sourceDate={r.last_checked} confidenceLabel={r.source_url && !r.needs_review ? "Source-backed" : "Needs verification"} />
      </div>
    ))}
  </section>

  <!-- 5. Import requirements -->
  <section>
    <h2>{sect("importRequirements")}</h2>
    {rel?.import_eligibility ? (
      <>
        <p>{rel.import_eligibility.notes ?? rel.import_eligibility.summary}</p>
        {rel.import_eligibility.requirements && rel.import_eligibility.requirements.length > 0 && (
          <ul>{rel.import_eligibility.requirements.map((req) => <li>{req}</li>)}</ul>
        )}
        <SourceNote source={rel.import_eligibility.source} sourceUrl={rel.import_eligibility.source_url} sourceDate={rel.import_eligibility.checked_date} confidenceLabel={relConfidenceLabel(rel.import_eligibility)} caveat={rel.import_eligibility.needs_review ? verifyCaveat : undefined} />
      </>
    ) : (
      <p>{misc("noEligibility")}</p>
    )}
  </section>

  <!-- 6. Charging (EV only) -->
  {rel?.ev_charging_compat ? (
    <section>
      <h2>{sect("charging")}</h2>
      <p>{rel.ev_charging_compat.notes ?? rel.ev_charging_compat.summary}</p>
      <table class="data-table">
        <thead><tr><th>{misc("attribute")}</th><th>{misc("value")}</th></tr></thead>
        <tbody>
          <tr><td>{misc("chargingStd")}</td><td>{rel.ev_charging_compat.standard ?? na}</td></tr>
          <tr><td>{misc("destinationStd")}</td><td>{rel.ev_charging_compat.destination_standard ?? na}</td></tr>
          <tr><td>{misc("adapterNeeded")}</td><td>{rel.ev_charging_compat.needs_adapter ? t(dict, "vehicle.misc.yes") : na}</td></tr>
          <tr><td>{misc("voltage")}</td><td>{rel.ev_charging_compat.voltage ?? na}</td></tr>
          <tr><td>{misc("frequency")}</td><td>{rel.ev_charging_compat.frequency ?? na}</td></tr>
        </tbody>
      </table>
      <SourceNote source={rel.ev_charging_compat.source} sourceUrl={rel.ev_charging_compat.source_url} sourceDate={rel.ev_charging_compat.checked_date} confidenceLabel={relConfidenceLabel(rel.ev_charging_compat)} caveat={rel.ev_charging_compat.needs_review ? chargingCaveat : undefined} />
      {evRules.length > 0 && (
        <div class="rule">
          {evRules.map((r) => (
            <>
              <div class="rule-head">
                <h3>{r.title}</h3>
                {r.needs_review && <span class="badge-review">{t(dict, "common.needsReview")}</span>}
              </div>
              <p>{r.rule_text}</p>
              <SourceNote source={r.source} sourceUrl={r.source_url} sourceDate={r.last_checked} confidenceLabel={r.source_url && !r.needs_review ? "Source-backed" : "Needs verification"} />
            </>
          ))}
        </div>
      )}
    </section>
  ) : (
    <section>
      <h2>{sect("charging")}</h2>
      <p>{misc("noCharging")}</p>
    </section>
  )}

  <!-- 7. Parts & service -->
  <section>
    <h2>{sect("partsService")}</h2>
    {rel?.model_considerations ? (
      <>
        <p>{rel.model_considerations.summary}</p>
        <SourceNote source={rel.model_considerations.source} sourceUrl={rel.model_considerations.source_url} sourceDate={rel.model_considerations.checked_date} confidenceLabel={relConfidenceLabel(rel.model_considerations)} caveat={rel.model_considerations.needs_review ? dealerCaveat : undefined} />
      </>
    ) : (
      <p>{misc("noParts")}</p>
    )}
    <p class="review-hint">{misc("partsHint")}</p>
  </section>

  <!-- 8. Landed cost -->
  <section>
    <h2>{sect("landedCost")}</h2>
    {duty ? (
      <>
        <p>{misc("dutyAnchorsIntro", { country: countryName })}</p>
        <table class="data-table">
          <thead><tr><th>{misc("charge")}</th><th>{misc("rate")}</th></tr></thead>
          <tbody>
            {duty.standard && <tr><td>{duty.standard.label}</td><td>{duty.standard.rate}</td></tr>}
            {duty.ev && <tr><td>{duty.ev.label}</td><td>{duty.ev.rate}</td></tr>}
            {duty.vat && <tr><td>{duty.vat.label}</td><td>{duty.vat.rate}</td></tr>}
          </tbody>
        </table>
        {rel?.duty_anchors && (
          <SourceNote source={rel.duty_anchors.source} sourceUrl={rel.duty_anchors.source_url} sourceDate={rel.duty_anchors.checked_date} confidenceLabel={relConfidenceLabel(rel.duty_anchors)} caveat={rel.duty_anchors.needs_review ? dutyCaveat : undefined} />
        )}
      </>
    ) : (
      <p>{misc("noDutyAnchors")}</p>
    )}
    <p class="review-hint" set:html={misc("landedCostHint", { link: `<a href="${TOOLS_SITE_URL}/landed-cost-calculator/">${t(dict, "country.misc.toolLandedCost")}</a>` })} />
  </section>

  <!-- 9. Known limitations -->
  <section>
    <h2>{sect("knownLimitations")}</h2>
    <ul>
      {rel?.drive_side_fit?.status === "mismatch" && (
        <li>{misc("limitationDriveMismatch", { country: countryName, driveSide: driveSideLabel })}</li>
      )}
      {rel?.age_rule_fit?.status === "borderline" && <li>{misc("limitationAgeBorderline")}</li>}
      {rel?.age_rule_fit?.status === "ineligible" && <li>{misc("limitationAgeIneligible")}</li>}
      {rel?.ev_charging_compat?.needs_adapter && <li>{misc("limitationCharging")}</li>}
      {!hasLimitations && <li>{misc("limitationNone")}</li>}
    </ul>
  </section>

  <!-- 9b. Key risks -->
  <section>
    <h2>{sect("keyRisks")}</h2>
    {risks.length > 0 ? (
      <ul class="risk-list">
        {risks.map((r) => (
          <li class="risk">
            <span class="risk-text">{r.text}</span>
            <SourceNote source={r.source} sourceUrl={r.source_url} sourceDate={r.checked_date} confidenceLabel={relConfidenceLabel(r)} caveat={r.needs_review ? verifyCaveat : undefined} />
          </li>
        ))}
      </ul>
    ) : (
      <p>{misc("noRisks")}</p>
    )}
  </section>

  <!-- 9c. Practical checklist -->
  <section>
    <h2>{sect("practicalChecklist")}</h2>
    <p class="review-hint">{misc("checklistHint")}</p>
    {checklistItems.length > 0 ? (
      <ol class="check-list">
        {checklistItems.map((c) => (
          <li class="check-item">
            <span class="check-text">{c.text}</span>
            <SourceNote source={c.source} sourceUrl={c.source_url} sourceDate={c.checked_date} confidenceLabel={relConfidenceLabel(c)} caveat={c.needs_review ? verifyCaveat : undefined} />
          </li>
        ))}
      </ol>
    ) : (
      <p>{misc("noChecklist")}</p>
    )}
  </section>

  <!-- 10. Sources & confidence -->
  <section>
    <h2>{sect("sourcesConfidence")}</h2>
    <p class="review-hint">{misc("sourceConfidenceHint")}</p>
    <ul class="src-confidence">
      {rel?.drive_side_fit && <li>{misc("srcDriveFit")} — <span class={"badge " + relConfidenceClass(rel.drive_side_fit)}>{cl(rel.drive_side_fit)}</span> · {rel.drive_side_fit.source}</li>}
      {rel?.age_rule_fit && <li>{misc("srcAgeFit")} — <span class={"badge " + relConfidenceClass(rel.age_rule_fit)}>{cl(rel.age_rule_fit)}</span> · {rel.age_rule_fit.source}</li>}
      {rel?.powertrain_fit && <li>{misc("srcPowertrainFit")} — <span class={"badge " + relConfidenceClass(rel.powertrain_fit)}>{cl(rel.powertrain_fit)}</span> · {rel.powertrain_fit.source}</li>}
      {rel?.ev_charging_compat && <li>{misc("srcCharging")} — <span class={"badge " + relConfidenceClass(rel.ev_charging_compat)}>{cl(rel.ev_charging_compat)}</span> · {rel.ev_charging_compat.source}</li>}
      {rel?.import_eligibility && <li>{misc("srcEligibility")} — <span class={"badge " + relConfidenceClass(rel.import_eligibility)}>{cl(rel.import_eligibility)}</span> · {rel.import_eligibility.source}</li>}
      {rel?.duty_anchors && <li>{misc("srcDuty")} — <span class={"badge " + relConfidenceClass(rel.duty_anchors)}>{cl(rel.duty_anchors)}</span> · {rel.duty_anchors.source}</li>}
      {rel?.shipping_route && <li>{misc("srcShipping")} — <span class={"badge " + relConfidenceClass(rel.shipping_route)}>{cl(rel.shipping_route)}</span> · {rel.shipping_route.source}</li>}
    </ul>
  </section>

  <!-- 11. Shipping -->
  <section>
    <h2>{sect("shipping")}</h2>
    {shippingRoutes.length > 0 ? (
      <table class="data-table">
        <thead><tr><th>{t(dict, "country.misc.thOrigin")}</th><th>{t(dict, "country.misc.thDestination")}</th><th>{t(dict, "country.misc.thDays")}</th><th>{t(dict, "country.misc.thMethod")}</th></tr></thead>
        <tbody>
          {shippingRoutes.map((r) => (
            <tr>
              <td>{portName(r.origin_port_id)}</td>
              <td>{portName(r.destination_port_id)}</td>
              <td>{r.est_days_min}–{r.est_days_max}</td>
              <td>{methodLabel(r.shipping_method)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : (
      <p>{misc("noShipping")}</p>
    )}
    {rel?.shipping_route && (
      <>
        <p>{rel.shipping_route.notes}</p>
        <SourceNote source={rel.shipping_route.source} sourceUrl={rel.shipping_route.source_url} sourceDate={rel.shipping_route.checked_date} confidenceLabel={relConfidenceLabel(rel.shipping_route)} caveat={rel.shipping_route.needs_review ? transitCaveat : undefined} />
      </>
    )}
  </section>

  <!-- 12. Related -->
  <section>
    <h2>{sect("related")}</h2>
    {sameVehicleOtherCountries.length > 0 && (
      <>
        <h3>{sect("thisVehicleOtherCountries")}</h3>
        <ul>
          {sameVehicleOtherCountries.map((s) => (
            <li><a href={localizedUrl(`/countries/${s.country_id}/${vehicleId}/`, locale)}>{t(dict, "country.misc.inCountry", { model: modelName, country: getCountry(s.country_id)?.name ?? s.country_id })}</a></li>
          ))}
        </ul>
      </>
    )}
    {siblingPairs.length > 0 && (
      <>
        <h3>{sect("otherVehiclesInCountry", { country: countryName })}</h3>
        <ul>
          {siblingPairs.map((s) => (
            <li><a href={localizedUrl(`/countries/${countryId}/${s.vehicle_id}/`, locale)}>{t(dict, "country.misc.inCountry", { model: getModel(s.vehicle_id)?.name ?? s.vehicle_id, country: countryName })}</a></li>
          ))}
        </ul>
      </>
    )}
    <ul>
