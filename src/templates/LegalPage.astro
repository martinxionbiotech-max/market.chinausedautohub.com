---
import BaseLayout from "../../shared/components/BaseLayout.astro";
import { MARKET_SITE_URL, CONTACT } from "../../shared/config/config";
import { getTranslations, DEFAULT_LOCALE, type Locale } from "../i18n";
import { localizedUrl } from "../lib/i18n";

interface Section { h: string; p: string[] }
interface LegalPageContent {
  title: string;
  description: string;
  h1: string;
  intro?: string;
  sections: Section[];
}
interface Props {
  variant: string; // privacy | terms | cookies | disclaimer
}

const { variant } = Astro.props;
const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const dict = getTranslations(locale);

const page = (dict.legal as Record<string, LegalPageContent>)[variant];
if (!page) throw new Error(`Unknown legal page variant: ${variant}`);

const lastUpdated = (dict.legal as unknown as { lastUpdated?: string }).lastUpdated ?? "";

function render(p: string): string {
  return p
    .replaceAll('{siteName}', dict.site.name)
    .replaceAll('{email}', `<a href="mailto:${CONTACT.email}">${CONTACT.email}</a>`)
    .replaceAll('{whatsapp}', `<a href="${CONTACT.whatsappLink}" target="_blank" rel="noopener noreferrer">${CONTACT.whatsapp}</a>`);
}
---

<BaseLayout
  siteTitle={dict.site.name}
  siteUrl={MARKET_SITE_URL}
  currentSection="market"
  title={page.title}
  description={page.description}
  canonical={`/${variant}/`}
  localized
  breadcrumbs={[
    { name: dict.breadcrumb.markets, url: localizedUrl("/", locale) },
    { name: page.h1, url: localizedUrl(`/${variant}/`, locale) },
  ]}
>
  <h1>{page.h1}</h1>
  {lastUpdated && <p class="legal-meta">{lastUpdated}</p>}
  {page.intro && <p class="lede">{page.intro}</p>}
  <div class="legal">
    {page.sections.map((s) => (
      <section>
        <h2>{s.h}</h2>
        {s.p.map((p) => <p set:html={render(p)} />)}
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .lede { font-size: 17px; color: var(--color-text-soft); max-width: 68ch; }
  .legal-meta { color: var(--color-text-soft); font-size: 14px; margin: var(--space-2) 0 0; }
  .legal section { margin-top: var(--space-5); }
  .legal h2 { font-size: 19px; margin: 0 0 var(--space-2); }
  .legal p { margin: var(--space-2) 0; max-width: 72ch; }
  .legal a { color: var(--color-accent); }
</style>
