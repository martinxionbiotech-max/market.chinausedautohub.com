---
import BaseLayout from "../../../../shared/components/BaseLayout.astro";
import SourceNote from "../../../../shared/components/SourceNote.astro";
import {
  MARKET_SITE_URL,
  DATA_SITE_URL,
  TOOLS_SITE_URL,
} from "../../../../shared/config/config";
import {
  countries,
  rulesByCategory,
  getTaxRules,
  models,
} from "../../../lib/market";
import { countryContent } from "../../../lib/content";

export function getStaticPaths() {
  return countries.map((c) => ({ params: { country: c.country_id } }));
}

const { country: countryId } = Astro.params;
const country = countries.find((c) => c.country_id === countryId);
const content = countryContent[countryId];

const evRules = rulesByCategory(countryId, "ev_policy");
const evTax = getTaxRules(countryId).filter((t) =>
  t.label.toLowerCase().includes("electric")
);
const evModels = models.filter((m) =>
  m.generations.some((g) => g.trims.some((t) => ["ev", "phev"].includes(t.powertrain)))
).slice(0, 5);

const pageUrl = MARKET_SITE_URL + `/countries/${country.country_id}/ev/`;
const title = `Electric Vehicles in ${country.name} — Import Rules & Incentives`;
const description = `EV import rules, duty treatment and incentives for importing electric vehicles from China to ${country.name}.`;

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  url: pageUrl,
  dateModified: "2026-10-04",
  inLanguage: "en",
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Markets", item: MARKET_SITE_URL + "/" },
    { "@type": "ListItem", position: 2, name: country.name, item: MARKET_SITE_URL + `/countries/${country.country_id}/` },
    { "@type": "ListItem", position: 3, name: "EV guide", item: pageUrl },
  ],
};
---

<BaseLayout
  siteTitle="China Used Car Export Markets"
  siteUrl={MARKET_SITE_URL}
  currentSection="market"
  title={title}
  description={description}
  canonical={`/countries/${country.country_id}/ev/`}
  jsonLd={[articleLd, breadcrumbLd]}
  breadcrumbs={[
    { name: "Markets", url: "/" },
    { name: country.name, url: `/countries/${country.country_id}/` },
    { name: "EV guide", url: `/countries/${country.country_id}/ev/` },
  ]}
>
  <h1>Electric Vehicles in {country.name}</h1>
  <p><a href={`/countries/${country.country_id}/`}>← Back to {country.name} market guide</a></p>

  <section>
    <h2>Overview</h2>
    <p>{content.evNote}</p>
  </section>

  <section>
    <h2>EV Policy</h2>
    {evRules.length > 0 ? (
      evRules.map((r) => (
        <div class="rule">
          <div class="rule-head">
            <h3>{r.title}</h3>
            {r.needs_review && <span class="badge-review">Needs review</span>}
          </div>
          <p>{r.rule_text}</p>
          <SourceNote source={r.source} sourceUrl={r.source_url} sourceDate={r.source_date} confidence={r.confidence} />
          <p class="checked">Last checked: {r.last_checked}</p>
        </div>
      ))
    ) : (
      <p>No EV-specific policy recorded for this market.</p>
    )}
  </section>

  <section>
    <h2>Duty &amp; Tax Treatment for EVs</h2>
    {evTax.length > 0 ? (
      <table class="data-table">
        <thead>
          <tr><th>Label</th><th>Rate</th><th>Basis</th><th>Source</th><th>Review</th></tr>
        </thead>
        <tbody>
          {evTax.map((t) => (
            <tr>
              <td>{t.label}</td>
              <td>{t.rate_pct}%</td>
              <td>{t.basis}</td>
              <td>{t.source_url ? <a href={t.source_url} rel="noopener">{t.source}</a> : t.source}</td>
              <td>{t.needs_review ? <span class="badge-review">Review</span> : "—"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : (
      <p>No EV-specific duty entries recorded — EV imports generally follow standard duty rates. Verify with official customs.</p>
    )}
    <p class="review-hint">Confirm current EV duty treatment with official customs before trading.</p>
  </section>

  <section>
    <h2>Popular EV &amp; PHEV Models</h2>
    <ul>
      {evModels.map((m) => (
        <li>
          <a href={DATA_SITE_URL + "/models/"}>{m.name}</a>
          <span class="zh">{m.name_zh}</span> — {m.body_type.toUpperCase()}
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Calculate Landed Cost</h2>
    <p>
      Use the <a href={TOOLS_SITE_URL + "/landed-cost-calculator/"}>import cost calculator</a> to
      estimate landed cost for an EV import.
    </p>
  </section>

  <style>
    .zh { color: var(--color-text-soft); font-size: 0.85em; margin-left: var(--space-2); }
    section { margin-top: var(--space-6); }
    section h2 { border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-2); }
    .rule { border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-4); margin: var(--space-3) 0; }
    .rule-head { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
    .rule-head h3 { margin: 0; font-size: 16px; }
    .badge-review { display: inline-block; background: #fbe9e7; color: var(--color-danger); padding: 2px 8px; border-radius: var(--radius-sm); font-size: 12px; font-weight: 600; }
    .review-hint { background: var(--color-bg-alt); border-left: 3px solid var(--color-warning); padding: var(--space-3); font-size: 14px; }
    .checked { font-size: 12px; color: var(--color-text-soft); margin: var(--space-2) 0 0; }
  </style>
</BaseLayout>
