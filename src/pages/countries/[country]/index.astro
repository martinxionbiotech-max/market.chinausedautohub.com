---
import BaseLayout from "../../../../shared/components/BaseLayout.astro";
import SourceNote from "../../../../shared/components/SourceNote.astro";
import {
  MARKET_SITE_URL,
  DATA_SITE_URL,
  TOOLS_SITE_URL,
  MAIN_SITE_URL,
} from "../../../../shared/config/config";
import {
  countries,
  getRules,
  rulesByCategory,
  getTaxRules,
  getDestPorts,
  getRoutesForCountry,
  portName,
  getModel,
  brands,
  models,
} from "../../../lib/market";
import { countryContent, regionMeta } from "../../../lib/content";

export function getStaticPaths() {
  return countries.map((c) => ({ params: { country: c.country_id } }));
}

const { country: countryId } = Astro.params;
const country = countries.find((c) => c.country_id === countryId);
const content = countryContent[countryId];

const siteTitle = "China Used Car Export Markets";
const rules = getRules(countryId);
const ageRules = rulesByCategory(countryId, "vehicle_age");
const driveRules = rulesByCategory(countryId, "drive_side");
const evRules = rulesByCategory(countryId, "ev_policy");
const regRules = rulesByCategory(countryId, "registration")
  .concat(rulesByCategory(countryId, "import_eligibility"));
const tax = getTaxRules(countryId);
const dutyRules = tax.filter((t) => t.tax_type === "import_duty");
const otherTax = tax.filter((t) => t.tax_type !== "import_duty");
const evTax = tax.filter((t) => t.label.toLowerCase().includes("electric"));
const evModels = models
  .filter((m) => m.generations.some((g) => g.trims.some((t) => ["ev", "phev"].includes(t.powertrain))))
  .slice(0, 5);
const destPorts = getDestPorts(countryId);
const shippingRoutes = getRoutesForCountry(countryId);

// Official Sources: dedupe source names from this country's rules + taxrules, count citations.
const sourceMap = new Map<string, { urls: string[]; count: number }>();
for (const item of [...rules, ...tax]) {
  const key = item.source || "Unknown source";
  const entry = sourceMap.get(key) ?? { urls: [] as string[], count: 0 };
  entry.count += 1;
  if (item.source_url && !entry.urls.includes(item.source_url)) {
    entry.urls.push(item.source_url);
  }
  sourceMap.set(key, entry);
}
const officialSources = [...sourceMap.entries()].map(([source, e]) => ({
  source,
  urls: e.urls,
  count: e.count,
}));

const driveSide = country.drive_side === "lhd" ? "Left-hand drive (LHD)" : "Right-hand drive (RHD)";
const taxTypeLabel: Record<string, string> = {
  import_duty: "Import duty",
  vat: "VAT",
  excise: "Excise",
  other: "Other",
};
const methodLabel = (m: string, source: string) =>
  (m === "roro" ? "RoRo" : "Container") + (source.includes("rail") ? " (rail transit)" : "");

const popularModels = (content.popularModelIds || [])
  .map((id) => getModel(id))
  .filter(Boolean);
const cnBrands = brands.filter((b) => b.origin_country === "CN");

const pageUrl = MARKET_SITE_URL + `/countries/${country.country_id}/`;
const description = `Importing used cars from China to ${country.name}: drive side, vehicle age rules, import duty and VAT, ports and shipping routes — with sources and confidence levels.`;

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: `Importing used cars from China to ${country.name}`,
  description,
  url: pageUrl,
  dateModified: "2026-10-04",
  inLanguage: "en",
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Markets", item: MARKET_SITE_URL + "/" },
    { "@type": "ListItem", position: 2, name: country.name, item: pageUrl },
  ],
};
---

<BaseLayout
  siteTitle={siteTitle}
  siteUrl={MARKET_SITE_URL}
  currentSection="market"
  title={`Import Used Cars to ${country.name} — Rules, Duties & Routes`}
  description={description}
  canonical={`/countries/${country.country_id}/`}
  jsonLd={[articleLd, breadcrumbLd]}
  breadcrumbs={[
    { name: "Markets", url: "/" },
    { name: country.name, url: `/countries/${country.country_id}/` },
  ]}
>
  <h1>{country.name} <span class="zh">{country.name_zh}</span></h1>
  <p class="meta-line">
    {regionMeta[country.region]?.label} · {driveSide} · Currency {country.currency}
  </p>

  <p class="disclaimer">
    Rules may change. Verify current requirements with official authorities before
    trading.
  </p>

  <!-- 1. Market Overview -->
  <section>
    <h2>Market Overview</h2>
    <p>{content.overview}</p>
  </section>

  <!-- 2. Import Regulations -->
  <section>
    <h2>Import Regulations</h2>
    <p class="review-hint">
      Regulations are high-risk data. Every rule below carries a source and confidence
      level. <strong>Confirm with official customs before trading</strong>.
    </p>
    <div class="rule-list">
      {rules.map((r) => (
        <article class="rule">
          <div class="rule-head">
            <h3>{r.title}</h3>
            {r.needs_review && <span class="badge-review">Needs review</span>}
          </div>
          <p>{r.rule_text}</p>
          <SourceNote
            source={r.source}
            sourceUrl={r.source_url}
            sourceDate={r.source_date}
            confidence={r.confidence}
            effectiveDate={r.effective_date}
            notes={r.notes}
          />
          <p class="checked">Last checked: {r.last_checked}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- 3. Vehicle Age Rules -->
  <section>
    <h2>Vehicle Age Rules</h2>
    {ageRules.length > 0 ? (
      ageRules.map((r) => (
        <div class="rule">
          <div class="rule-head">
            <h3>{r.title}</h3>
            {r.needs_review && <span class="badge-review">Needs review</span>}
          </div>
          <p>{r.rule_text}</p>
          <SourceNote source={r.source} sourceUrl={r.source_url} sourceDate={r.source_date} confidence={r.confidence} effectiveDate={r.effective_date} notes={r.notes} />
          <p class="checked">Last checked: {r.last_checked}</p>
        </div>
      ))
    ) : (
      <p>No specific age rule recorded. Verify age limits with official customs.</p>
    )}
  </section>

  <!-- 4. Drive Side -->
  <section>
    <h2>Drive Side</h2>
    <p class="drive-callout">{driveSide}</p>
    {driveRules.map((r) => (
      <div class="rule">
        <div class="rule-head">
          <h3>{r.title}</h3>
          {r.needs_review && <span class="badge-review">Needs review</span>}
        </div>
        <p>{r.rule_text}</p>
        <SourceNote source={r.source} sourceUrl={r.source_url} sourceDate={r.source_date} confidence={r.confidence} effectiveDate={r.effective_date} notes={r.notes} />
        <p class="checked">Last checked: {r.last_checked}</p>
      </div>
    ))}
  </section>

  <!-- 5. Import Duties -->
  <section>
    <h2>Import Duties</h2>
    <p class="review-hint">
      Rates come from <code>taxrules.json</code> and may change. <strong>Confirm with
      official customs before trading</strong>.
    </p>
    <table class="data-table">
      <thead>
        <tr><th>Type</th><th>Label</th><th>Rate</th><th>Basis</th><th>Source</th><th>Source date</th><th>Review</th><th>Notes</th></tr>
      </thead>
      <tbody>
        {dutyRules.map((t) => (
          <tr>
            <td>{taxTypeLabel[t.tax_type] ?? t.tax_type}</td>
            <td>{t.label}</td>
            <td>{t.rate_pct}%</td>
            <td>{t.basis}</td>
            <td>{t.source_url ? <a href={t.source_url} rel="noopener">{t.source}</a> : t.source}</td>
            <td>{t.source_date ?? "—"}</td>
            <td>{t.needs_review ? <span class="badge-review">Review</span> : "—"}</td>
            <td>{t.notes ?? "—"}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <!-- 6. VAT & Taxes -->
  <section>
    <h2>VAT &amp; Taxes</h2>
    <table class="data-table">
      <thead>
        <tr><th>Type</th><th>Label</th><th>Rate</th><th>Basis</th><th>Source</th><th>Source date</th><th>Review</th><th>Notes</th></tr>
      </thead>
      <tbody>
        {otherTax.map((t) => (
          <tr>
            <td>{taxTypeLabel[t.tax_type] ?? t.tax_type}</td>
            <td>{t.label}</td>
            <td>{t.rate_pct}%</td>
            <td>{t.basis}</td>
            <td>{t.source_url ? <a href={t.source_url} rel="noopener">{t.source}</a> : t.source}</td>
            <td>{t.source_date ?? "—"}</td>
            <td>{t.needs_review ? <span class="badge-review">Review</span> : "—"}</td>
            <td>{t.notes ?? "—"}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="checked">Tax data last checked: 2026-10-04</p>
  </section>

  <!-- Official Sources -->
  <section>
    <h2>Official Sources</h2>
    <p class="review-hint">
      Official authorities cited for {country.name}'s import rules and tax rules.
      Verify current requirements with these sources before trading.
    </p>
    {officialSources.length > 0 ? (
      <ul class="source-list">
        {officialSources.map((s) => (
          <li>
            {s.urls.length > 0 ? (
              <a href={s.urls[0]} rel="noopener">{s.source}</a>
            ) : (
              <span>{s.source}</span>
            )}
            <span class="src-count"> — {s.count} rule{s.count === 1 ? "" : "s"}</span>
          </li>
        ))}
      </ul>
    ) : (
      <p>No source URLs recorded for this market.</p>
    )}
  </section>

  <!-- 7. EV Rules -->
  <section id="ev-rules">
    <h2>EV Rules</h2>
    {content.evNote && <p>{content.evNote}</p>}
    {evRules.length > 0 ? (
      evRules.map((r) => (
        <div class="rule">
          <div class="rule-head">
            <h3>{r.title}</h3>
            {r.needs_review && <span class="badge-review">Needs review</span>}
          </div>
          <p>{r.rule_text}</p>
          <SourceNote source={r.source} sourceUrl={r.source_url} sourceDate={r.source_date} confidence={r.confidence} effectiveDate={r.effective_date} notes={r.notes} />
          <p class="checked">Last checked: {r.last_checked}</p>
        </div>
      ))
    ) : (
      <p>No EV-specific rules recorded for this market.</p>
    )}

    <h3>EV Duty &amp; Tax Treatment</h3>
    {evTax.length > 0 ? (
      <table class="data-table">
        <thead>
          <tr><th>Label</th><th>Rate</th><th>Basis</th><th>Source</th><th>Review</th></tr>
        </thead>
        <tbody>
          {evTax.map((t) => (
            <tr>
              <td>{t.label}</td>
              <td>{t.rate_pct}%</td>
              <td>{t.basis}</td>
              <td>{t.source_url ? <a href={t.source_url} rel="noopener">{t.source}</a> : t.source}</td>
              <td>{t.needs_review ? <span class="badge-review">Review</span> : "—"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : (
      <p>No EV-specific duty entries recorded — EV imports generally follow standard duty rates. Verify with official customs.</p>
    )}
    <p class="review-hint">Confirm current EV duty treatment with official customs before trading. For a cross-country comparison, see the <a href="/ev-import/">EV import center</a>.</p>

    <h3>Popular EV &amp; PHEV Models</h3>
    {evModels.length > 0 ? (
      <ul>
        {evModels.map((m) => (
          <li>
            <a href={DATA_SITE_URL + "/models/" + m.model_id + "/"}>{m.name}</a>
            <span class="zh">{m.name_zh}</span> — {m.body_type.toUpperCase()}
          </li>
        ))}
      </ul>
    ) : (
      <p>No EV or PHEV models recorded for this market yet.</p>
    )}
  </section>

  <!-- 8. Registration -->
  <section>
    <h2>Registration</h2>
    {regRules.length > 0 ? (
      regRules.map((r) => (
        <div class="rule">
          <div class="rule-head">
            <h3>{r.title}</h3>
            {r.needs_review && <span class="badge-review">Needs review</span>}
          </div>
          <p>{r.rule_text}</p>
          <SourceNote source={r.source} sourceUrl={r.source_url} sourceDate={r.source_date} confidence={r.confidence} effectiveDate={r.effective_date} notes={r.notes} />
          <p class="checked">Last checked: {r.last_checked}</p>
        </div>
      ))
    ) : (
      <p>Registration is handled by the national licensing authority after import. Verify requirements with local authorities.</p>
    )}
  </section>

  <!-- 9. Ports -->
  <section>
    <h2>Ports</h2>
    <ul>
      {destPorts.map((p) => (
        <li>
          {p.name}
          {p.note && <span class="port-note"> — {p.note}</span>}
        </li>
      ))}
    </ul>
  </section>

  <!-- 10. Shipping From China -->
  <section>
    <h2>Shipping From China</h2>
    <p class="estimates">
      Transit times are industry estimates, not guarantees. Actual schedules and rates
      vary by carrier and season.
    </p>
    <table class="data-table">
      <thead>
        <tr><th>Origin port</th><th>Destination</th><th>Est. days</th><th>Method</th></tr>
      </thead>
      <tbody>
        {shippingRoutes.map((r) => (
          <tr>
            <td>{portName(r.origin_port_id)}</td>
            <td>{portName(r.destination_port_id)}</td>
            <td>{r.est_days_min}–{r.est_days_max}</td>
            <td>{methodLabel(r.shipping_method, r.source)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <!-- 11. Popular Vehicle Types -->
  <section>
    <h2>Popular Vehicle Types</h2>
    <ul>
      {popularModels.map((m) => (
        <li>
          <a href={DATA_SITE_URL + "/models/" + m.model_id + "/"}>{m.name}</a>
          <span class="zh">{m.name_zh}</span> — {m.body_type.toUpperCase()}
        </li>
      ))}
    </ul>
  </section>

  <!-- 12. Chinese Vehicle Brands -->
  <section>
    <h2>Chinese Vehicle Brands</h2>
    <ul class="brand-list">
      {cnBrands.map((b) => (
        <li>
          <a href={DATA_SITE_URL + "/brands/" + b.brand_id + "/"}>{b.name}</a>
          <span class="zh">{b.name_zh}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- 13. Import Costs -->
  <section>
    <h2>Import Costs</h2>
    <p>
      The landed cost is made up of the vehicle price, freight, insurance, import duty,
      VAT and any excise or inspection fees. For a full breakdown, use the
      <a href={TOOLS_SITE_URL + "/landed-cost-calculator/"}> import cost calculator</a>.
    </p>
  </section>

  <!-- 14. Market Considerations -->
  <section>
    <h2>Market Considerations</h2>
    <ul>
      {content.considerations.map((c) => (
        <li>{c}</li>
      ))}
    </ul>
  </section>

  <!-- 15. Related Tools -->
  <section>
    <h2>Related Tools</h2>
    <ul>
      <li><a href={TOOLS_SITE_URL + "/landed-cost-calculator/"}>Import Cost Calculator</a></li>
      <li><a href={TOOLS_SITE_URL + "/import-duty-calculator/"}>Import Duty Calculator</a></li>
      <li><a href={TOOLS_SITE_URL + "/currency-converter/"}>Currency Converter</a></li>
      <li><a href={TOOLS_SITE_URL + "/vehicle-comparison/"}>Vehicle Comparison</a></li>
    </ul>
  </section>

  <!-- 16. Available Vehicles & Request -->
  <section>
    <h2>Available Vehicles</h2>
    <p>
      Browse current stock and inquire about vehicles available for export to
      {country.name}.
    </p>
    <ul class="cta-list">
      <li><a class="cta" href={MAIN_SITE_URL + "/cars/"}>Browse available vehicles →</a></li>
      <li><a class="cta cta-alt" href={MAIN_SITE_URL + "/contact/"}>Request a vehicle →</a></li>
    </ul>
    <ul class="related-links">
      <li><a href={DATA_SITE_URL + "/vehicle-types/suv/"}>Browse SUVs</a></li>
      <li><a href={DATA_SITE_URL + "/vehicle-types/sedan/"}>Browse Sedans</a></li>
      <li><a href={DATA_SITE_URL + "/vehicle-types/ev/"}>Browse EVs</a></li>
    </ul>
  </section>

  <!-- 17. FAQ -->
  <section>
    <h2>FAQ</h2>
    <div class="faq">
      {content.faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <p class="disclaimer">
    Rules may change. Verify current requirements with official authorities before
    trading.
  </p>

  <style>
    .zh { color: var(--color-text-soft); font-size: 0.85em; margin-left: var(--space-2); }
    .meta-line { color: var(--color-text-soft); }
    section { margin-top: var(--space-6); }
    section h2 { border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-2); }
    .rule { border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-4); margin: var(--space-3) 0; }
    .rule-head { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
    .rule-head h3 { margin: 0; font-size: 16px; }
    .badge-review { display: inline-block; background: #fbe9e7; color: var(--color-danger); padding: 2px 8px; border-radius: var(--radius-sm); font-size: 12px; font-weight: 600; }
    .review-hint { background: var(--color-bg-alt); border-left: 3px solid var(--color-warning); padding: var(--space-3); font-size: 14px; }
    .estimates { font-size: 14px; color: var(--color-text-soft); }
    .checked { font-size: 12px; color: var(--color-text-soft); margin: var(--space-2) 0 0; }
    .drive-callout { font-size: 18px; font-weight: 700; color: var(--color-primary); }
    .port-note { color: var(--color-text-soft); font-size: 0.9em; }
    .brand-list { column-count: 2; }
    .faq summary { cursor: pointer; font-weight: 600; }
    .faq p { margin: var(--space-2) 0 var(--space-3); color: var(--color-text-soft); }
    .disclaimer { background: #fff7e6; border: 1px solid var(--color-warning); border-left: 4px solid var(--color-warning); padding: var(--space-3) var(--space-4); font-size: 14px; font-weight: 600; margin: var(--space-4) 0; }
    .source-list { list-style: none; padding: 0; }
    .source-list li { padding: var(--space-2) 0; border-bottom: 1px solid var(--color-border); }
    .src-count { color: var(--color-text-soft); font-size: 0.9em; }
    .cta-list { list-style: none; padding: 0; display: flex; gap: var(--space-3); flex-wrap: wrap; }
    .cta { display: inline-block; background: var(--color-primary); color: #fff; padding: var(--space-2) var(--space-4); border-radius: var(--radius-md); font-weight: 600; }
    .cta:hover { text-decoration: none; opacity: 0.92; }
    .cta-alt { background: var(--color-accent); }
    .related-links { margin-top: var(--space-3); }
    @media (max-width: 600px) { .brand-list { column-count: 1; } }
  </style>
</BaseLayout>
