---
import BaseLayout from "../../../../shared/components/BaseLayout.astro";
import SourceNote from "../../../../shared/components/SourceNote.astro";
import {
  MARKET_SITE_URL,
  DATA_SITE_URL,
  TOOLS_SITE_URL,
  MAIN_SITE_URL,
} from "../../../../shared/config/config";
import {
  countries,
  getRules,
  rulesByCategory,
  getTaxRules,
  getDestPorts,
  getRoutesForCountry,
  portName,
  getModel,
  brands,
  models,
  confidenceLabel,
  confidenceClass,
  jurisdictionFor,
  applicabilityForCategory,
  applicabilityForTaxType,
} from "../../../lib/market";
import { countryContent, regionMeta } from "../../../lib/content";
import { getRelationsForCountry } from "../../../lib/vehicle-market";

export function getStaticPaths() {
  return countries.map((c) => ({ params: { country: c.country_id } }));
}

const { country: countryId } = Astro.params;
const country = countries.find((c) => c.country_id === countryId);
const content = countryContent[countryId];

const siteTitle = "China Used Car Export Markets";
const rules = getRules(countryId);
const ageRules = rulesByCategory(countryId, "vehicle_age");
const driveRules = rulesByCategory(countryId, "drive_side");
const evRules = rulesByCategory(countryId, "ev_policy");
const tax = getTaxRules(countryId);
const dutyRules = tax.filter((t) => t.tax_type === "import_duty");
const otherTax = tax.filter((t) => t.tax_type !== "import_duty");
const evTax = tax.filter((t) => t.label.toLowerCase().includes("electric"));
const evModels = models
  .filter((m) => m.generations.some((g) => g.trims.some((t) => ["ev", "phev"].includes(t.powertrain))))
  .slice(0, 5);
const destPorts = getDestPorts(countryId);
const shippingRoutes = getRoutesForCountry(countryId);

const jurisdiction = jurisdictionFor(countryId);

// Official Sources: dedupe source names from this country's rules + taxrules, count citations.
const sourceMap = new Map<string, { urls: string[]; count: number }>();
for (const item of [...rules, ...tax]) {
  const key = item.source || "Unknown source";
  const entry = sourceMap.get(key) ?? { urls: [] as string[], count: 0 };
  entry.count += 1;
  if (item.source_url && !entry.urls.includes(item.source_url)) {
    entry.urls.push(item.source_url);
  }
  sourceMap.set(key, entry);
}
const officialSources = [...sourceMap.entries()].map(([source, e]) => ({
  source,
  urls: e.urls,
  count: e.count,
}));

const driveSide = country.drive_side === "lhd" ? "Left-hand drive (LHD)" : "Right-hand drive (RHD)";
const methodLabel = (m: string, source: string) =>
  (m === "roro" ? "RoRo" : "Container") + (source.includes("rail") ? " (rail transit)" : "");

const popularModels = (content.popularModelIds || [])
  .map((id) => getModel(id))
  .filter(Boolean);
const cnBrands = brands.filter((b) => b.origin_country === "CN");

const docsRules = rulesByCategory(countryId, "import_eligibility");
const segmentTypes = [...new Set(popularModels.map((m) => m.body_type))];

// Vehicle × Market combination pages generated for this country.
const vehiclePairs = getRelationsForCountry(countryId);

// Confidence distribution using the PHASE 6 five-level labels.
const allDeclarations = [...rules, ...tax];
const confCounts = {
  Confirmed: 0,
  "Source-backed": 0,
  "Needs verification": 0,
  Estimated: 0,
  Unknown: 0,
} as Record<string, number>;
for (const item of allDeclarations) {
  confCounts[confidenceLabel(item)] += 1;
}
const totalDeclarations = allDeclarations.length;
const lastChecked = rules.length > 0 ? rules[0].last_checked : "Not available";

const pageUrl = MARKET_SITE_URL + `/countries/${country.country_id}/`;
const description = `Importing used cars from China to ${country.name}: drive side, vehicle age rules, import duty and VAT, ports and shipping routes — each statement with source, date checked, jurisdiction, applicability and confidence level.`;

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: `Importing used cars from China to ${country.name}`,
  description,
  url: pageUrl,
  dateModified: "2026-10-04",
  inLanguage: "en",
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Markets", item: MARKET_SITE_URL + "/" },
    { "@type": "ListItem", position: 2, name: country.name, item: pageUrl },
  ],
};

// Per-rule metadata block reused across sections.
const ruleMeta = (r: any) => ({
  label: confidenceLabel(r),
  jurisdiction,
  applicability: applicabilityForCategory(r.category),
  caveat: r.needs_review
    ? "Verify with the official authority before trading."
    : r.notes ?? undefined,
});
const taxMeta = (t: any) => ({
  label: confidenceLabel(t),
  jurisdiction,
  applicability: applicabilityForTaxType(t.tax_type),
  caveat: t.needs_review
    ? "Verify with the official authority before trading."
    : t.notes ?? undefined,
});
---

<BaseLayout
  siteTitle={siteTitle}
  siteUrl={MARKET_SITE_URL}
  currentSection="market"
  title={`Import Used Cars to ${country.name} — Rules, Duties & Routes`}
  description={description}
  canonical={`/countries/${country.country_id}/`}
  jsonLd={[articleLd, breadcrumbLd]}
  breadcrumbs={[
    { name: "Markets", url: "/" },
    { name: country.name, url: `/countries/${country.country_id}/` },
  ]}
>
  <h1>{country.name} <span class="zh">{country.name_zh}</span></h1>
  <p class="meta-line">
    {regionMeta[country.region]?.label} · {driveSide} · Currency {country.currency} · Jurisdiction {jurisdiction}
  </p>

  <p class="disclaimer">
    This information is provided for general guidance only and is <strong>not legal
    advice</strong>. Consult the relevant destination-country authorities (customs,
    tax and transport authorities) before trading. Rules may change; verify current
    requirements with official authorities.
  </p>

  <!-- Confidence legend (PHASE 6 five-level labels) -->
  <section>
    <h2>How to Read the Confidence Labels</h2>
    <p class="review-hint">
      Every rule and tax statement on this page carries a confidence label plus its
      source, date checked, jurisdiction, applicability and caveat.
    </p>
    <ul class="legend">
      <li><span class="badge badge-high">Source-backed</span> — cited to an official government, customs or transport source URL.</li>
      <li><span class="badge badge-medium">Needs verification</span> — not yet confirmed against a current official source; verify before trading.</li>
      <li><span class="badge badge-low">Estimated</span> — an estimate or a figure that changes frequently.</li>
      <li><span class="badge badge-unknown">Unknown</span> — no reliable source recorded.</li>
      <li><span class="badge badge-muted">Confirmed</span> — independently verified against an official document. No statement on this page currently meets this bar.</li>
    </ul>
  </section>

  <!-- 1. Market Overview -->
  <section>
    <h2>Market Overview</h2>
    <p>{content.overview}</p>
  </section>

  <!-- 2. Import Eligibility -->
  <section>
    <h2>Import Eligibility</h2>
    <p class="review-hint">
      This is <strong>not legal advice</strong> — consult destination-country
      authorities. Regulations are high-risk data. Every rule below carries a source,
      date checked, jurisdiction, applicability and confidence level.{" "}
      <strong>Confirm with official customs before trading</strong>.
    </p>
    <div class="rule-list">
      {rules.map((r) => {
        const m = ruleMeta(r);
        return (
          <article class="rule">
            <div class="rule-head">
              <h3>{r.title}</h3>
              {r.needs_review && <span class="badge-review">Needs review</span>}
            </div>
            <p>{r.rule_text}</p>
            <SourceNote
              source={r.source}
              sourceUrl={r.source_url}
              sourceDate={r.last_checked}
              confidenceLabel={m.label}
              effectiveDate={r.effective_date}
              jurisdiction={m.jurisdiction}
              applicability={m.applicability}
              caveat={m.caveat}
            />
          </article>
        );
      })}
    </div>
  </section>

  <!-- 3. Vehicle Age Rules -->
  <section>
    <h2>Vehicle Age Rules</h2>
    {ageRules.length > 0 ? (
      ageRules.map((r) => {
        const m = ruleMeta(r);
        return (
          <div class="rule">
            <div class="rule-head">
              <h3>{r.title}</h3>
              {r.needs_review && <span class="badge-review">Needs review</span>}
            </div>
            <p>{r.rule_text}</p>
            <SourceNote
              source={r.source}
              sourceUrl={r.source_url}
              sourceDate={r.last_checked}
              confidenceLabel={m.label}
              effectiveDate={r.effective_date}
              jurisdiction={m.jurisdiction}
              applicability={m.applicability}
              caveat={m.caveat}
            />
          </div>
        );
      })
    ) : (
      <p>No specific age rule recorded. Verify age limits with official customs.</p>
    )}
  </section>

  <!-- 4. Drive Side -->
  <section>
    <h2>Drive Side</h2>
    <p class="drive-callout">{driveSide}</p>
    {driveRules.map((r) => {
      const m = ruleMeta(r);
      return (
        <div class="rule">
          <div class="rule-head">
            <h3>{r.title}</h3>
            {r.needs_review && <span class="badge-review">Needs review</span>}
          </div>
          <p>{r.rule_text}</p>
          <SourceNote
            source={r.source}
            sourceUrl={r.source_url}
            sourceDate={r.last_checked}
            confidenceLabel={m.label}
            effectiveDate={r.effective_date}
            jurisdiction={m.jurisdiction}
            applicability={m.applicability}
            caveat={m.caveat}
          />
        </div>
      );
    })}
  </section>

  <!-- 5. Import Duties -->
  <section>
    <h2>Import Duties</h2>
    <p class="review-hint">
      Rates come from <code>taxrules.json</code> and may change.{" "}
      <strong>Confirm with official customs before trading</strong>.
    </p>
    {dutyRules.length > 0 ? (
      dutyRules.map((t) => {
        const m = taxMeta(t);
        return (
          <div class="rule">
            <div class="rule-head">
              <h3>{t.label} — {t.rate_pct}%</h3>
              {t.needs_review && <span class="badge-review">Review</span>}
            </div>
            <p>Basis: {t.basis}</p>
            <SourceNote
              source={t.source}
              sourceUrl={t.source_url}
              sourceDate={t.source_date ?? t.last_checked}
              confidenceLabel={m.label}
              effectiveDate={t.effective_date}
              jurisdiction={m.jurisdiction}
              applicability={m.applicability}
              caveat={m.caveat}
            />
          </div>
        );
      })
    ) : (
      <p>No import duty recorded for this market.</p>
    )}
  </section>

  <!-- 6. VAT & Taxes -->
  <section>
    <h2>VAT &amp; Taxes</h2>
    {otherTax.length > 0 ? (
      otherTax.map((t) => {
        const m = taxMeta(t);
        return (
          <div class="rule">
            <div class="rule-head">
              <h3>{t.label} — {t.rate_pct}%</h3>
              {t.needs_review && <span class="badge-review">Review</span>}
            </div>
            <p>Basis: {t.basis}</p>
            <SourceNote
              source={t.source}
              sourceUrl={t.source_url}
              sourceDate={t.source_date ?? t.last_checked}
              confidenceLabel={m.label}
              effectiveDate={t.effective_date}
              jurisdiction={m.jurisdiction}
              applicability={m.applicability}
              caveat={m.caveat}
            />
          </div>
        );
      })
    ) : (
      <p>No VAT or additional tax recorded for this market.</p>
    )}
    <p class="checked">Tax data last checked: 2026-10-04</p>
  </section>

  <!-- Official Sources -->
  <section>
    <h2>Official Sources</h2>
    <p class="review-hint">
      Official authorities cited for {country.name}'s import rules and tax rules.
      Verify current requirements with these sources before trading.
    </p>
    {officialSources.length > 0 ? (
      <ul class="source-list">
        {officialSources.map((s) => (
          <li>
            {s.urls.length > 0 ? (
              <a href={s.urls[0]} rel="noopener">{s.source}</a>
            ) : (
              <span>{s.source}</span>
            )}
            <span class="src-count"> — {s.count} rule{s.count === 1 ? "" : "s"}</span>
          </li>
        ))}
      </ul>
    ) : (
      <p>No source URLs recorded for this market.</p>
    )}
  </section>

  <!-- 7. EV Rules -->
  <section id="ev-rules">
    <h2>EV Rules</h2>
    {content.evNote && <p>{content.evNote}</p>}
    {evRules.length > 0 ? (
      evRules.map((r) => {
        const m = ruleMeta(r);
        return (
          <div class="rule">
            <div class="rule-head">
              <h3>{r.title}</h3>
              {r.needs_review && <span class="badge-review">Needs review</span>}
            </div>
            <p>{r.rule_text}</p>
            <SourceNote
              source={r.source}
              sourceUrl={r.source_url}
              sourceDate={r.last_checked}
              confidenceLabel={m.label}
              effectiveDate={r.effective_date}
              jurisdiction={m.jurisdiction}
              applicability={m.applicability}
              caveat={m.caveat}
            />
          </div>
        );
      })
    ) : (
      <p>No EV-specific rules recorded for this market.</p>
    )}

    <h3>EV Duty &amp; Tax Treatment</h3>
    {evTax.length > 0 ? (
      evTax.map((t) => {
        const m = taxMeta(t);
        return (
          <div class="rule">
            <div class="rule-head">
              <h3>{t.label} — {t.rate_pct}%</h3>
              {t.needs_review && <span class="badge-review">Review</span>}
            </div>
            <p>Basis: {t.basis}</p>
            <SourceNote
              source={t.source}
              sourceUrl={t.source_url}
              sourceDate={t.source_date ?? t.last_checked}
              confidenceLabel={m.label}
              effectiveDate={t.effective_date}
              jurisdiction={m.jurisdiction}
              applicability={m.applicability}
              caveat={m.caveat}
            />
          </div>
        );
      })
    ) : (
      <p>No EV-specific duty entries recorded — EV imports generally follow standard duty rates. Verify with official customs.</p>
    )}
    <p class="review-hint">Confirm current EV duty treatment with official customs before trading. For a cross-country comparison, see the <a href="/ev-import/">EV import center</a>.</p>

    <h3>Popular EV &amp; PHEV Models</h3>
    {evModels.length > 0 ? (
      <ul>
        {evModels.map((m) => (
          <li>
            <a href={DATA_SITE_URL + "/models/" + m.model_id + "/"}>{m.name}</a>
            <span class="zh">{m.name_zh}</span> — {m.body_type.toUpperCase()}
          </li>
        ))}
      </ul>
    ) : (
      <p>No EV or PHEV models recorded for this market yet.</p>
    )}
  </section>

  <!-- 8. Registration / Required Documents -->
  <section>
    <h2>Required Documents</h2>
    {docsRules.length > 0 ? (
      docsRules.map((r) => {
        const m = ruleMeta(r);
        return (
          <div class="rule">
            <div class="rule-head">
              <h3>{r.title}</h3>
              {r.needs_review && <span class="badge-review">Needs review</span>}
            </div>
            <p>{r.rule_text}</p>
            <SourceNote
              source={r.source}
              sourceUrl={r.source_url}
              sourceDate={r.last_checked}
              confidenceLabel={m.label}
              effectiveDate={r.effective_date}
              jurisdiction={m.jurisdiction}
              applicability={m.applicability}
              caveat={m.caveat}
            />
          </div>
        );
      })
    ) : (
      <p>No specific document or certification requirements recorded. Verify current requirements with official authorities before trading.</p>
    )}
  </section>

  <!-- 9. Ports -->
  <section>
    <h2>Ports</h2>
    <ul>
      {destPorts.map((p) => (
        <li>
          {p.name}
          {p.note && <span class="port-note"> — {p.note}</span>}
        </li>
      ))}
    </ul>
  </section>

  <!-- 10. Shipping From China -->
  <section>
    <h2>Shipping From China</h2>
    <p class="estimates">
      Transit times are industry estimates, not guarantees. Actual schedules and rates
      vary by carrier and season.
    </p>
    <table class="data-table">
      <thead>
        <tr><th>Origin port</th><th>Destination</th><th>Est. days</th><th>Method</th></tr>
      </thead>
      <tbody>
        {shippingRoutes.map((r) => (
          <tr>
            <td>{portName(r.origin_port_id)}</td>
            <td>{portName(r.destination_port_id)}</td>
            <td>{r.est_days_min}–{r.est_days_max}</td>
            <td>{methodLabel(r.shipping_method, r.source)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="checked">
      Transit estimates are not confirmed schedules — treat them as indicative (Estimated confidence).
    </p>
  </section>

  <!-- 10b. Vehicle × Market compatibility pages -->
  {vehiclePairs.length > 0 && (
    <section id="vehicle-compatibility">
      <h2>Vehicle Compatibility Pages</h2>
      <p class="review-hint">
        Model-specific export compatibility &amp; cost pages for {country.name}.
        These are generated only where a model × market pairing produces
        knowledge the country and model pages do not state on their own.
      </p>
      <ul>
        {vehiclePairs.map((p) => (
          <li>
            <a href={`/countries/${country.country_id}/${p.vehicle_id}/`}>
              {getModel(p.vehicle_id)?.name ?? p.vehicle_id} in {country.name}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- 11. Popular Vehicle Types -->
  <section>
    <h2>Popular Vehicle Types</h2>
    <ul>
      {popularModels.map((m) => (
        <li>
          <a href={DATA_SITE_URL + "/models/" + m.model_id + "/"}>{m.name}</a>
          <span class="zh">{m.name_zh}</span> — {m.body_type.toUpperCase()}
        </li>
      ))}
    </ul>
  </section>

  <!-- 11b. Vehicle Segment Fit -->
  <section>
    <h2>Vehicle Segment Fit</h2>
    {segmentTypes.length > 0 ? (
      <p>
        Popular models in this market are predominantly{" "}
        {segmentTypes.map((t) => t.toUpperCase()).join(" and ")} segments.
        {content.suvNote && <span class="segment-note"> {content.suvNote}</span>}
      </p>
    ) : (
      <p>No vehicle segment data recorded for this market.</p>
    )}
  </section>

  <!-- 12. Chinese Vehicle Brands -->
  <section>
    <h2>Chinese Vehicle Brands</h2>
    <ul class="brand-list">
      {cnBrands.map((b) => (
        <li>
          <a href={DATA_SITE_URL + "/brands/" + b.brand_id + "/"}>{b.name}</a>
          <span class="zh">{b.name_zh}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- 13. Import Costs -->
  <section>
    <h2>Import Costs</h2>
    <p>
      The landed cost is made up of the vehicle price, freight, insurance, import duty,
      VAT and any excise or inspection fees. For a full breakdown, use the
      <a href={TOOLS_SITE_URL + "/landed-cost-calculator/"}> import cost calculator</a>.
    </p>
  </section>

  <!-- 14. Market Considerations -->
  <section>
    <h2>Market Considerations</h2>
    <ul>
      {content.considerations.map((c) => (
        <li>{c}</li>
      ))}
    </ul>
  </section>

  <!-- 15. Related Tools -->
  <section>
    <h2>Related Tools</h2>
    <ul>
      <li><a href={TOOLS_SITE_URL + "/landed-cost-calculator/"}>Import Cost Calculator</a></li>
      <li><a href={TOOLS_SITE_URL + "/import-duty-calculator/"}>Import Duty Calculator</a></li>
      <li><a href={TOOLS_SITE_URL + "/currency-converter/"}>Currency Converter</a></li>
      <li><a href={TOOLS_SITE_URL + "/vehicle-comparison/"}>Vehicle Comparison</a></li>
    </ul>
  </section>

  <!-- 15b. Related Guides -->
  <section>
    <h2>Related Guides</h2>
    <ul>
      <li><a href={MAIN_SITE_URL + "/guides/how-to-buy-used-car-from-china/"}>How to Buy a Used Car from China</a></li>
      <li><a href={MAIN_SITE_URL + "/guides/china-used-car-export-process/"}>China Used Car Export Process</a></li>
      <li><a href={MAIN_SITE_URL + "/guides/export-documents/"}>Export Documents</a></li>
      <li><a href={MAIN_SITE_URL + "/guides/shipping/"}>Shipping</a></li>
      <li><a href={MAIN_SITE_URL + "/guides/landed-cost/"}>Landed Cost</a></li>
      <li><a href={MAIN_SITE_URL + "/guides/vehicle-inspection/"}>Vehicle Inspection</a></li>
    </ul>
  </section>

  <!-- 16. Available Vehicles & Request -->
  <section>
    <h2>Available Vehicles</h2>
    <p>
      Browse current stock and inquire about vehicles available for export to
      {country.name}.
    </p>
    <ul class="cta-list">
      <li><a class="cta" href={MAIN_SITE_URL + "/cars/"}>Browse available vehicles →</a></li>
      <li><a class="cta cta-alt" href={MAIN_SITE_URL + "/contact/"}>Request a vehicle →</a></li>
    </ul>
    <ul class="related-links">
      <li><a href={DATA_SITE_URL + "/vehicle-types/suv/"}>Browse SUVs</a></li>
      <li><a href={DATA_SITE_URL + "/vehicle-types/sedan/"}>Browse Sedans</a></li>
      <li><a href={DATA_SITE_URL + "/vehicle-types/ev/"}>Browse EVs</a></li>
    </ul>
  </section>

  <!-- 17. FAQ -->
  <section>
    <h2>FAQ</h2>
    <div class="faq">
      {content.faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- 18. Verification Date & Evidence Status -->
  <section>
    <h2>Verification Date &amp; Evidence Status</h2>
    <p class="checked">Rule and tax data on this page last checked: {lastChecked}</p>
    <ul>
      <li>{totalDeclarations} rule and tax statements recorded for {country.name}.</li>
      <li>
        Confidence: {confCounts["Confirmed"]} Confirmed · {confCounts["Source-backed"]} Source-backed ·{" "}
        {confCounts["Needs verification"]} Needs verification · {confCounts["Estimated"]} Estimated ·{" "}
        {confCounts["Unknown"]} Unknown.
      </li>
    </ul>
    <p class="review-hint">
      Confidence reflects how strongly each statement is evidenced by its cited source,
      not a guarantee of current accuracy. Re-verify rates and rules with official
      customs before trading.
    </p>
  </section>

  <p class="disclaimer">
    This information is provided for general guidance only and is <strong>not legal
    advice</strong>. Consult the relevant destination-country authorities (customs,
    tax and transport authorities) before trading. Rules may change.
  </p>

  <style>
    .zh { color: var(--color-text-soft); font-size: 0.85em; margin-left: var(--space-2); }
    .meta-line { color: var(--color-text-soft); }
    section { margin-top: var(--space-6); }
    section h2 { border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-2); }
    .rule { border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-4); margin: var(--space-3) 0; }
    .rule-head { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
    .rule-head h3 { margin: 0; font-size: 16px; }
    .badge-review { display: inline-block; background: #fbe9e7; color: var(--color-danger); padding: 2px 8px; border-radius: var(--radius-sm); font-size: 12px; font-weight: 600; }
