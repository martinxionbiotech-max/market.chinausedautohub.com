---
import BaseLayout from "../../../../shared/components/BaseLayout.astro";
import SpecTable from "../../../../shared/components/SpecTable.astro";
import {
  MARKET_SITE_URL,
  DATA_SITE_URL,
  TOOLS_SITE_URL,
  MAIN_SITE_URL,
} from "../../../../shared/config/config";
import { getModel, getBrand, rulesByCategory } from "../../../lib/market";

const model = getModel("byd-song-plus");
const brand = getBrand("byd");
const gen = model.generations[0];
const trim = gen.trims[0];
const s = trim.specs;

const driveRules = rulesByCategory("kenya", "drive_side");
const ageRules = rulesByCategory("kenya", "vehicle_age");

const specRows = [
  { label: "Brand", value: brand.name },
  { label: "Body type", value: "SUV" },
  { label: "Powertrain options", value: "PHEV (DM-i) / EV" },
  { label: "Seats", value: s.seats },
  { label: "Length (mm)", value: s.length_mm },
  { label: "Width (mm)", value: s.width_mm },
  { label: "Height (mm)", value: s.height_mm },
  { label: "Wheelbase (mm)", value: s.wheelbase_mm },
  { label: "Drive type", value: s.drive_type?.toUpperCase() },
];

const pageUrl = MARKET_SITE_URL + "/countries/kenya/byd-song-plus/";
const title = "BYD Song Plus in Kenya — Import Guide";
const description =
  "Importing the BYD Song Plus (宋PLUS) to Kenya: model overview, import considerations, compatibility with Kenya's RHD and 8-year age rules, and cost estimation.";

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  url: pageUrl,
  dateModified: "2026-10-04",
  inLanguage: "en",
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Markets", item: MARKET_SITE_URL + "/" },
    { "@type": "ListItem", position: 2, name: "Kenya", item: MARKET_SITE_URL + "/countries/kenya/" },
    { "@type": "ListItem", position: 3, name: "BYD Song Plus", item: pageUrl },
  ],
};
---

<BaseLayout
  siteTitle="China Used Car Export Markets"
  siteUrl={MARKET_SITE_URL}
  currentSection="market"
  title={title}
  description={description}
  canonical="/countries/kenya/byd-song-plus/"
  jsonLd={[articleLd, breadcrumbLd]}
  breadcrumbs={[
    { name: "Markets", url: "/" },
    { name: "Kenya", url: "/countries/kenya/" },
    { name: "BYD Song Plus", url: "/countries/kenya/byd-song-plus/" },
  ]}
>
  <h1>BYD Song Plus in Kenya</h1>
  <p><a href="/countries/kenya/">← Back to Kenya market guide</a></p>

  <section>
    <h2>Model Overview</h2>
    <p>
      The BYD Song Plus ({model.name_zh}) is a compact SUV available as a PHEV (DM-i)
      and a pure EV. The DM-i powertrains are popular in Kenya for their low running
      costs. Full generation, trim and specification detail is on the
      <a href={DATA_SITE_URL + "/models/byd-song-plus/"}> DATA site</a>.
    </p>
    <SpecTable rows={specRows} />
    <p class="checked">Specifications are for the first-generation model as recorded in the DATA site; trim-level data may vary.</p>
  </section>

  <section>
    <h2>Import Considerations</h2>
    <p>
      The Song Plus must meet Kenya's import requirements. Below are the recorded rules;
      confirm with official customs before trading.
    </p>
    {driveRules.map((r) => (
      <div class="rule">
        <div class="rule-head">
          <h3>{r.title}</h3>
          {r.needs_review && <span class="badge-review">Needs review</span>}
        </div>
        <p>{r.rule_text}</p>
      </div>
    ))}
    {ageRules.map((r) => (
      <div class="rule">
        <div class="rule-head">
          <h3>{r.title}</h3>
          {r.needs_review && <span class="badge-review">Needs review</span>}
        </div>
        <p>{r.rule_text}</p>
      </div>
    ))}
  </section>

  <section>
    <h2>Estimated Cost</h2>
    <p>
      Landed cost is made up of the vehicle price, freight, import duty, VAT and excise.
      For a full estimate, use the
      <a href={TOOLS_SITE_URL + "/landed-cost-calculator/"}> import cost calculator</a>.
    </p>
  </section>

  <section>
    <h2>Compatibility</h2>
    <ul>
      <li><strong>Drive side:</strong> Kenya is right-hand drive (RHD). Confirm the Song Plus is sourced in RHD for this market before export.</li>
      <li><strong>Age rule:</strong> Kenya limits imports to vehicles no older than eight years. Current-generation Song Plus (2020+) units fall within this limit.</li>
    </ul>
  </section>

  <section>
    <h2>Current Vehicles</h2>
    <p>
      See available vehicles and inquire on the
      <a href={MAIN_SITE_URL + "/cars/"}> main site</a>.
    </p>
  </section>

  <section>
    <h2>Estimate Your Import</h2>
    <p>
      <a href={TOOLS_SITE_URL + "/landed-cost-calculator/"}>Open the import cost calculator →</a>
    </p>
  </section>

  <style>
    section { margin-top: var(--space-6); }
    section h2 { border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-2); }
    .rule { border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-4); margin: var(--space-3) 0; }
    .rule-head { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
    .rule-head h3 { margin: 0; font-size: 16px; }
    .badge-review { display: inline-block; background: #fbe9e7; color: var(--color-danger); padding: 2px 8px; border-radius: var(--radius-sm); font-size: 12px; font-weight: 600; }
    .checked { font-size: 12px; color: var(--color-text-soft); }
  </style>
</BaseLayout>
