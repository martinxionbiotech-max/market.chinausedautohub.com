---
import BaseLayout from "../../../shared/components/BaseLayout.astro";
import SourceNote from "../../../shared/components/SourceNote.astro";
import { MARKET_SITE_URL } from "../../../shared/config/config";
import { countries, rules } from "../../lib/market";

const siteTitle = "China Used Car Export Markets";

const pageUrl = MARKET_SITE_URL + "/import-guides/";
const title = "Import Guides by Country — Rules, Sources & Confidence";
const description =
  "All recorded used-car import rules grouped by destination country, each with source, confidence level and review status. Verify with official customs before trading.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: pageUrl,
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Markets", item: MARKET_SITE_URL + "/" },
    { "@type": "ListItem", position: 2, name: "Import guides", item: pageUrl },
  ],
};

const catLabel: Record<string, string> = {
  vehicle_age: "Vehicle age",
  drive_side: "Drive side",
  ev_policy: "EV policy",
  registration: "Registration",
  emission: "Emission",
  import_eligibility: "Import eligibility",
  other: "Other",
};

const grouped = countries.map((c) => ({
  country: c,
  countryRules: rules.filter((r) => r.country_id === c.country_id),
}));
---

<BaseLayout
  siteTitle={siteTitle}
  siteUrl={MARKET_SITE_URL}
  currentSection="market"
  title={title}
  description={description}
  canonical="/import-guides/"
  jsonLd={[jsonLd, breadcrumbLd]}
  breadcrumbs={[
    { name: "Markets", url: "/" },
    { name: "Import guides", url: "/import-guides/" },
  ]}
>
  <h1>Import Guides by Country</h1>
  <p class="lede">
    {rules.length} recorded import rules across {countries.length} markets, grouped by
    country. Each rule carries a source, confidence level and review status.
  </p>

  <p class="review-hint">
    <strong>Confirm with official customs before trading.</strong> Regulatory data
    is high-risk and can change; treat every entry as reference only.
  </p>

  {grouped.map(({ country, countryRules }) => (
    <section>
      <h2>
        <a href={`/countries/${country.country_id}/`}>{country.name}</a>
        <span class="zh">{country.name_zh}</span>
      </h2>
      {countryRules.length > 0 ? (
        countryRules.map((r) => (
          <article class="rule">
            <div class="rule-head">
              <h3>{r.title}</h3>
              <span class="cat">{catLabel[r.category] ?? r.category}</span>
              {r.needs_review && <span class="badge-review">Needs review</span>}
            </div>
            <p>{r.rule_text}</p>
            <SourceNote source={r.source} sourceUrl={r.source_url} sourceDate={r.source_date} confidence={r.confidence} />
            <p class="checked">Last checked: {r.last_checked}</p>
          </article>
        ))
      ) : (
        <p>No data yet.</p>
      )}
    </section>
  ))}

  <style>
    .lede { font-size: 17px; color: var(--color-text-soft); max-width: 68ch; }
    .zh { color: var(--color-text-soft); font-size: 0.85em; margin-left: var(--space-2); }
    .review-hint { background: var(--color-bg-alt); border-left: 3px solid var(--color-warning); padding: var(--space-3); font-size: 14px; }
    section { margin-top: var(--space-6); }
    section h2 { border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-2); }
    .rule { border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-4); margin: var(--space-3) 0; }
    .rule-head { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
    .rule-head h3 { margin: 0; font-size: 16px; }
    .cat { background: var(--color-accent-soft); color: var(--color-accent); padding: 2px 8px; border-radius: var(--radius-sm); font-size: 12px; font-weight: 600; }
    .badge-review { display: inline-block; background: #fbe9e7; color: var(--color-danger); padding: 2px 8px; border-radius: var(--radius-sm); font-size: 12px; font-weight: 600; }
    .checked { font-size: 12px; color: var(--color-text-soft); margin: var(--space-2) 0 0; }
  </style>
</BaseLayout>
