---
import BaseLayout from "../../../shared/components/BaseLayout.astro";
import SourceNote from "../../../shared/components/SourceNote.astro";
import { MARKET_SITE_URL } from "../../../shared/config/config";
import { countries, rules } from "../../lib/market";

const siteTitle = "China Used Car Export Markets";

const pageUrl = MARKET_SITE_URL + "/documents/";
const title = "Required Documents for Used-Car Import";
const description =
  "Documentation requirements for importing used cars from China, drawn from recorded import rules. Requirements vary by country — verify with authorities.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: pageUrl,
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Markets", item: MARKET_SITE_URL + "/" },
    { "@type": "ListItem", position: 2, name: "Documents", item: pageUrl },
  ],
};

const docRules = rules.filter(
  (r) => r.category === "registration" || r.category === "documents"
);
const countryById = Object.fromEntries(countries.map((c) => [c.country_id, c]));
---

<BaseLayout
  siteTitle={siteTitle}
  siteUrl={MARKET_SITE_URL}
  currentSection="market"
  title={title}
  description={description}
  canonical="/documents/"
  jsonLd={[jsonLd, breadcrumbLd]}
  breadcrumbs={[
    { name: "Markets", url: "/" },
    { name: "Documents", url: "/documents/" },
  ]}
>
  <h1>Required Documents</h1>
  <p class="lede">
    Documentation requirements for importing used cars from China.
  </p>

  <p class="review-hint">
    <strong>Requirements vary by country — verify with authorities.</strong> This
    page lists only documentation requirements already recorded in the shared data
    set; it is not a complete checklist.
  </p>

  {docRules.length > 0 ? (
    docRules.map((r) => (
      <article class="rule">
        <div class="rule-head">
          <h3>
            {countryById[r.country_id] ? (
              <a href={`/countries/${r.country_id}/`}>{countryById[r.country_id].name}</a>
            ) : (
              r.country_id
            )}
            — {r.title}
          </h3>
          {r.needs_review && <span class="badge-review">Needs review</span>}
        </div>
        <p>{r.rule_text}</p>
        <SourceNote source={r.source} sourceUrl={r.source_url} sourceDate={r.source_date} confidence={r.confidence} />
        <p class="checked">Last checked: {r.last_checked}</p>
      </article>
    ))
  ) : (
    <p>No data yet.</p>
  )}

  <section>
    <h2>Where to confirm requirements</h2>
    <ul>
      {countries.map((c) => (
        <li>
          <a href={`/countries/${c.country_id}/`}>{c.name}</a> — see the
          "Official Sources" section on the country page.
        </li>
      ))}
    </ul>
  </section>

  <style>
    .lede { font-size: 17px; color: var(--color-text-soft); max-width: 68ch; }
    .review-hint { background: var(--color-bg-alt); border-left: 3px solid var(--color-warning); padding: var(--space-3); font-size: 14px; }
    section { margin-top: var(--space-6); }
    section h2 { border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-2); }
    .rule { border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-4); margin: var(--space-3) 0; }
    .rule-head { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
    .rule-head h3 { margin: 0; font-size: 16px; }
    .badge-review { display: inline-block; background: #fbe9e7; color: var(--color-danger); padding: 2px 8px; border-radius: var(--radius-sm); font-size: 12px; font-weight: 600; }
    .checked { font-size: 12px; color: var(--color-text-soft); margin: var(--space-2) 0 0; }
  </style>
</BaseLayout>
