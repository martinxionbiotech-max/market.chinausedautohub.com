---
import VehicleMarketPage from "../../../../../templates/VehicleMarketPage.astro";
import { relations, passesGate } from "../../../../../lib/vehicle-market";

export function getStaticPaths() {
  return relations.filter(passesGate).map((r) => ({
    params: { country: r.country_id, vehicle: r.vehicle_id },
  }));
}

const { country, vehicle } = Astro.params;
---
<VehicleMarketPage countryId={country} vehicleId={vehicle} />
