---
import BaseLayout from "../../../shared/components/BaseLayout.astro";
import { MARKET_SITE_URL } from "../../../shared/config/config";
import { countries, getRules, getTaxRules, getDestPorts, getRoutesForCountry } from "../../lib/market";
import { regionMeta } from "../../lib/content";

const siteTitle = "China Used Car Export Markets";
const regionOrder = ["middle-east", "africa", "central-asia"];

const pageUrl = MARKET_SITE_URL + "/regions/";
const title = "Export Regions — Middle East, Africa & Central Asia";
const description =
  "Regional market guide for used-car exports from China: shared drive side, import-rule coverage and transit characteristics for the Middle East, Africa and Central Asia.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: pageUrl,
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Markets", item: MARKET_SITE_URL + "/" },
    { "@type": "ListItem", position: 2, name: "Regions", item: pageUrl },
  ],
};

const driveLabel = (s: string) => (s === "lhd" ? "left-hand drive (LHD)" : "right-hand drive (RHD)");

// Derive region commonality strictly from the data.
const regionInfo = regionOrder.map((region) => {
  const members = countries.filter((c) => c.region === region);
  const driveSides = [...new Set(members.map((c) => c.drive_side))];
  const ruleCount = members.reduce((n, c) => n + getRules(c.country_id).length, 0);
  const taxCount = members.reduce((n, c) => n + getTaxRules(c.country_id).length, 0);
  const portCount = members.reduce((n, c) => n + getDestPorts(c.country_id).length, 0);

  // Transit: land/rail if every destination port note mentions rail, else sea.
  const destPorts = members.flatMap((c) => getDestPorts(c.country_id));
  const allRail = destPorts.length > 0 && destPorts.every((p) => (p.note || "").toLowerCase().includes("rail"));
  const hasRail = destPorts.some((p) => (p.note || "").toLowerCase().includes("rail"));

  const sharedDrive = driveSides.length === 1 ? driveLabel(driveSides[0]) : null;

  return { region, members, ruleCount, taxCount, portCount, sharedDrive, allRail, hasRail };
});
---

<BaseLayout
  siteTitle={siteTitle}
  siteUrl={MARKET_SITE_URL}
  currentSection="market"
  title={title}
  description={description}
  canonical="/regions/"
  jsonLd={[jsonLd, breadcrumbLd]}
  breadcrumbs={[
    { name: "Markets", url: "/" },
    { name: "Regions", url: "/regions/" },
  ]}
>
  <h1>Export Regions</h1>
  <p class="lede">
    Used-car export markets grouped by region. Shared characteristics below are
    derived directly from the recorded data (drive side and port/transit notes) —
    nothing else is inferred.
  </p>

  {regionInfo.map((r) => (
    <section id={r.region}>
      <h2>
        {regionMeta[r.region].label}
        <span class="zh">{regionMeta[r.region].label_zh}</span>
      </h2>

      <ul class="facts">
        {r.sharedDrive && (
          <li><strong>Drive side:</strong> all tracked markets in this region are {r.sharedDrive}.</li>
        )}
        {!r.sharedDrive && (
          <li><strong>Drive side:</strong> markets in this region differ — check each country page.</li>
        )}
        {r.allRail && (
          <li><strong>Transit:</strong> recorded ports indicate primarily land/rail transit from China.</li>
        )}
        {!r.allRail && r.hasRail && (
          <li><strong>Transit:</strong> a mix of sea and land/rail transit across markets.</li>
        )}
        {!r.hasRail && (
          <li><strong>Transit:</strong> recorded ports are seaports (RoRo/container).</li>
        )}
        <li><strong>Coverage:</strong> {r.ruleCount} import rules and {r.taxCount} tax rules tracked across {r.members.length} markets.</li>
      </ul>

      <ul class="country-list">
        {r.members.map((c) => (
          <li>
            <a href={`/countries/${c.country_id}/`}>{c.name}</a>
            <span class="zh">{c.name_zh}</span>
            <span class="meta">— {driveLabel(c.drive_side)} · {c.currency}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <p class="review-hint">
    Rules may change. Verify current requirements with official authorities before
    trading.
  </p>

  <style>
    .lede { font-size: 17px; color: var(--color-text-soft); max-width: 68ch; }
    .zh { color: var(--color-text-soft); font-size: 0.85em; margin-left: var(--space-2); }
    .meta { color: var(--color-text-soft); font-size: 0.9em; margin-left: var(--space-2); }
    section { margin-top: var(--space-6); }
    section h2 { border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-2); }
    .facts { font-size: 15px; }
    .facts li { margin: var(--space-1) 0; }
    .country-list { margin-top: var(--space-3); }
    .review-hint { background: var(--color-bg-alt); border-left: 3px solid var(--color-warning); padding: var(--space-3); font-size: 14px; margin-top: var(--space-6); }
  </style>
</BaseLayout>
